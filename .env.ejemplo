# Plantilla de configuracion. Copiala como .env y cambia los valores.
# El archivo .env es privado: no se sube a GitHub.

# Base de datos (opcional). Sin esta variable se usa sqlite:///cauce.db
# CAUCE_BASE_DE_DATOS="sqlite:///cauce.db"

# Nombres que quedan como autor de los registros importados
USUARIO_HISTORICO="Nombre Apellido"
USUARIO_FORMULARIOS="Nombre Apellido"

# Punto de partida del balance del reservorio (obligatorio para /balance).
# Fecha (AAAA-MM-DD) y nivel en m3 medidos fisicamente ese dia.
# Los valores de abajo son de ejemplo: use los de su medicion real.
CAUCE_FECHA_INICIO_BALANCE="2026-01-01"
CAUCE_NIVEL_INICIAL_M3="100"
# Personas que registran datos, separadas por comas
CAUCE_USUARIOS=Ana Prueba,Luis Ejemplo
