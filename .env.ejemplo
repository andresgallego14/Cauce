# Plantilla de configuracion. Copiala como .env y cambia los valores.
# El archivo .env es privado: no se sube a GitHub.

# Base de datos (opcional). Sin esta variable se usa sqlite:///cauce.db
# CAUCE_BASE_DE_DATOS="sqlite:///cauce.db"

# Nombres que quedan como autor de los registros importados
USUARIO_HISTORICO="Nombre Apellido"
USUARIO_FORMULARIOS="Nombre Apellido"